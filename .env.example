# AI for IoT - Smart Energy Consumption Prediction Environment Configuration
# Copy this file to .env to customize local server configuration

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Backend API Configuration
# Optional: Frontend API URL (leave empty for same-origin relative calls in local development)
VITE_API_URL=

# Model Paths (optional overrides)
# MODEL_PATH=AI_IoT_Project/models/lstm_model.keras
# FEATURE_SCALER_PATH=AI_IoT_Project/models/feature_scaler.pkl
# TARGET_SCALER_PATH=AI_IoT_Project/models/target_scaler.pkl

# Logging
LOG_LEVEL=INFO
